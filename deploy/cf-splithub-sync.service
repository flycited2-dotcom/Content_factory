[Unit]
Description=Content Factory — сверка каталога SplitHub (остатки, цены, фото, УТП)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/content-factory
Environment=PYTHONPATH=/opt/content-factory/src
ExecStart=/opt/content-factory/.venv/bin/python -m content_factory.splithub_sync
